---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COURSE_PREP_LABEL } from '../../data/course-prep';

// Sample course page for the CompTIA "Course Prep" (IT) section — ITP 1100.
// IN APPROVAL: noindex + mega menu. All copy is a working DRAFT, framed strictly
// as course/exam preparation (NOT job or entry-level-employment claims). Nothing
// final ships before Ramon signs off on the "course prep" language.
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5z"/></svg>';

const domains = [
  { n: 'IT Concepts & Terminology', d: 'Notational systems, data types, and fundamental computing concepts.' },
  { n: 'Infrastructure', d: 'Devices, internal components, networking, and connectivity basics.' },
  { n: 'Applications & Software', d: 'Operating systems, applications, browsers, and configuration.' },
  { n: 'Software Development Concepts', d: 'Programming logic, organizational structures, and language categories.' },
  { n: 'Data & Database Fundamentals', d: 'Data value, databases, and structured vs. non-structured storage.' },
  { n: 'Security', d: 'Confidentiality, integrity, availability, and everyday security practices.' },
];

const weeks = [
  { t: 'IT concepts & terminology', d: 'Core computing concepts, notational systems, and a structured troubleshooting methodology.' },
  { t: 'Infrastructure', d: 'Devices and internal components, connectivity, networking, and virtualization basics.' },
  { t: 'Applications & operating systems', d: 'Operating systems, applications, web browsers, and an introduction to software development.' },
  { t: 'Data & security', d: 'Data and database fundamentals, security principles, and full-course review.' },
];

const faqs = [
  { q: `Is this a job-training program?`, a: `No. ITP 1100 is a course that prepares you for the CompTIA Tech+ certification exam. It builds foundational IT knowledge and readiness for the exam, which is taken separately through CompTIA.` },
  { q: `Do I need any experience to start?`, a: `None. Tech+ Fundamentals is a beginner course. You should be comfortable using a computer and have reliable internet, but no prior IT coursework is required.` },
  { q: `Is the CompTIA exam included?`, a: `Academic completion of ITP 1100 is separate from the external CompTIA Tech+ exam. The course prepares you for the exam; you register for and sit the exam through CompTIA. Ask an advisor about current voucher and scheduling options.` },
  { q: `How is the course delivered?`, a: `Online through the Canvas learning platform, with two instructor-led live sessions each week (about 60 minutes) plus guided practice and knowledge checks.` },
];
---
<BaseLayout
  title={`ITP 1100 — Tech+ Fundamentals (CompTIA ${COURSE_PREP_LABEL}) | Florida Education Institute`}
  description="ITP 1100 Tech+ Fundamentals is a beginner online course at FEI that prepares you for the CompTIA Tech+ (FC0-U71) certification exam across its six domains."
  megaMenu
  noindex
>
  <div id="feiProgramMeta" data-program="ITP 1100 — Tech+ Fundamentals" data-program-type="CompTIA Course Prep" hidden></div>

  <!-- HERO -->
  <section class="phero phero--page">
    <div class="hero__bg" style="background-image:url('/img/students.jpg')" aria-hidden="true"></div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="phero__inner">
      <div class="phero__copy">
        <p class="eyebrow reveal" data-delay="0"><span class="eyebrow__dot"></span> CompTIA {COURSE_PREP_LABEL} · Foundations</p>
        <h1 class="phero__title reveal" data-delay="1">Tech+ Fundamentals</h1>
        <p class="phero__lede reveal" data-delay="2">A beginner-friendly course that builds your IT foundation and prepares you for the CompTIA Tech+ (FC0-U71) certification exam — computing concepts, infrastructure, applications, software development, data, and security.</p>
        <div class="hero__cta reveal" data-delay="3">
          <a href="/apply" class="btn btn--solid btn--lg" data-apply>Request info
            <Fragment set:html={arrow} />
          </a>
          <a href="/apply" class="btn btn--outline btn--lg btn--outline-light" data-apply>Apply now</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SNAPSHOT / FACT BAR -->
  <aside class="factbar" aria-label="Course at a glance">
    <div class="factbar__inner">
      <div class="factbar__item">
        <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
        <span class="factbar__txt"><strong>ITP 1100</strong><span>Course code</span></span>
      </div>
      <div class="factbar__item">
        <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4-8 4-8-4 8-4z"/><path d="M4 11v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5"/></svg></span>
        <span class="factbar__txt"><strong>CompTIA Tech+</strong><span>Prepares for FC0-U71</span></span>
      </div>
      <div class="factbar__item">
        <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
        <span class="factbar__txt"><strong>4 weeks · 4 credits</strong><span>Course length</span></span>
      </div>
      <div class="factbar__item">
        <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 20h8M12 17v3"/></svg></span>
        <span class="factbar__txt"><strong>Online · live</strong><span>Instructor-led</span></span>
      </div>
    </div>
  </aside>

  <!-- OVERVIEW -->
  <section class="section pblock">
    <div class="pblock__grid">
      <div>
        <p class="kicker">The Course</p>
        <h2 class="section__title section__title--sm">Your foundation<br/>in IT.</h2>
      </div>
      <div>
        <p class="pblock__text">Tech+ Fundamentals is the entry point of FEI's IT pathway. It introduces the vocabulary and concepts that every IT role builds on — how computers and networks work, how software and operating systems are used, how data is stored, and how security protects it — and gets you ready to sit the CompTIA Tech+ certification exam.</p>
        <p class="pblock__text" style="margin-top:1rem">No background is assumed. You learn through instructor-led online sessions and guided practice, then move on to certificate-track courses when you're ready.</p>
      </div>
    </div>
  </section>

  <!-- WHAT YOU'LL LEARN -->
  <section class="section pblock pblock--tint">
    <div class="pblock__grid">
      <div>
        <p class="kicker">What you'll learn</p>
        <h2 class="section__title section__title--sm">Skills you'll<br/>build.</h2>
      </div>
      <ul class="curriculum-list">
        <li>Explain fundamental computing concepts and troubleshoot common issues methodically</li>
        <li>Identify devices, internal components, and how they connect</li>
        <li>Describe networking, cloud, and operating-system concepts</li>
        <li>Use applications, web browsers, and collaboration and productivity tools</li>
        <li>Understand software development, data, databases, and backups</li>
        <li>Apply everyday security, privacy, authentication, and encryption practices</li>
      </ul>
    </div>
  </section>

  <!-- CERTIFICATION ALIGNMENT -->
  <section class="section pblock">
    <div class="pblock__grid">
      <div>
        <p class="kicker">Exam alignment</p>
        <h2 class="section__title section__title--sm">Mapped to the<br/>Tech+ exam.</h2>
      </div>
      <div>
        <p class="pblock__text">The course is organized around the six domains of the CompTIA Tech+ (FC0-U71) certification exam, so your coursework and your exam preparation move together.</p>
        <div class="cp-domains">
          {domains.map((d) => (
            <div class="cp-domain"><strong>{d.n}</strong><span>{d.d}</span></div>
          ))}
        </div>
        <p class="cp-note"><strong>About the exam:</strong> CompTIA Tech+ (FC0-U71) is a single exam of up to 70 questions in 60 minutes, with a passing score of 650 (on a 100–900 scale). It is administered by CompTIA and taken separately from this course.</p>
      </div>
    </div>
  </section>

  <!-- WEEKLY SEQUENCE -->
  <section class="section pblock pblock--tint">
    <div class="pblock__grid">
      <div>
        <p class="kicker">Weekly sequence</p>
        <h2 class="section__title section__title--sm">Four weeks,<br/>step by step.</h2>
      </div>
      <ol class="steps steps--compact">
        {weeks.map((w, i) => (
          <li class="step"><span class="step__no">{i + 1}</span><h3>Week {i + 1} — {w.t}</h3><p>{w.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- DELIVERY -->
  <section class="section pblock">
    <div class="pblock__grid">
      <div>
        <p class="kicker">How you'll learn</p>
        <h2 class="section__title section__title--sm">Online, live,<br/>and guided.</h2>
      </div>
      <div>
        <p class="pblock__text">Coursework is delivered online through the Canvas learning platform. Each week includes two instructor-led live sessions of about 60 minutes over Microsoft Teams, plus guided practice, readings, and ongoing knowledge checks so you always know where you stand.</p>
        <p class="pblock__text" style="margin-top:1rem">You study around work and family, with an instructor who knows your name and can answer questions in real time.</p>
      </div>
    </div>
  </section>

  <!-- PREREQUISITES / WHO SHOULD ENROLL -->
  <section class="section pblock pblock--tint">
    <div class="pblock__grid">
      <div>
        <p class="kicker">Who should enroll</p>
        <h2 class="section__title section__title--sm">Built for<br/>beginners.</h2>
      </div>
      <div>
        <p class="pblock__text"><strong>Prerequisites:</strong> none. This is a beginner course — you only need basic digital literacy and a reliable computer and internet connection.</p>
        <ul class="chips-list" style="margin-top:1rem">
          <li>New to IT and exploring the field</li>
          <li>Planning to pursue CompTIA certifications</li>
          <li>Building a base before the certificate tracks</li>
        </ul>
        <p class="pblock__text pblock__text--note">A grade of C or higher lets you continue to ITP 1200 and the Computer Technician track.</p>
      </div>
    </div>
  </section>

  <!-- MATERIALS & TECHNOLOGY -->
  <section class="section pblock">
    <div class="pblock__grid">
      <div>
        <p class="kicker">Materials & technology</p>
        <h2 class="section__title section__title--sm">What you'll<br/>need.</h2>
      </div>
      <ul class="curriculum-list">
        <li>FEI-approved CompTIA Tech+ study guide (provided digitally)</li>
        <li>Canvas quizzes, practice activities, and knowledge checks</li>
        <li>A reliable laptop or desktop computer</li>
        <li>A stable internet connection and a current web browser</li>
        <li>A microphone/headset for live sessions</li>
      </ul>
    </div>
  </section>

  <!-- EXAM READINESS NOTE -->
  <section class="section pblock pblock--tint">
    <div class="pblock__grid">
      <div>
        <p class="kicker">Exam readiness</p>
        <h2 class="section__title section__title--sm">Coursework and<br/>certification.</h2>
      </div>
      <div>
        <p class="pblock__text">This course is designed to prepare you thoroughly for the CompTIA Tech+ exam. Completing the course academically is <strong>separate</strong> from earning the certification: the credential is issued by CompTIA once you pass their external exam.</p>
        <p class="cp-note"><strong>Good to know:</strong> your instructor and advisor help you gauge exam readiness through practice checks along the way. When you're ready, ask your advisor about registering for the Tech+ exam and any available voucher options.</p>
      </div>
    </div>
  </section>

  <!-- CERTIFICATE PATHWAY -->
  <section class="section pblock">
    <div class="pblock__grid">
      <div>
        <p class="kicker">The pathway</p>
        <h2 class="section__title section__title--sm">Where this<br/>leads.</h2>
      </div>
      <div>
        <p class="pblock__text">Tech+ Fundamentals is the shared starting point for FEI's IT certificate tracks. From here you can continue into the Computer Technician and Networking Technician programs, stacking CompTIA certifications as you go.</p>
        <a href="/course-prep" class="link-arrow">See the full course catalog
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section pblock pblock--tint">
    <div class="pblock__grid">
      <div>
        <p class="kicker">FAQ</p>
        <h2 class="section__title section__title--sm">Quick<br/>answers</h2>
      </div>
      <div class="accordion" id="accordion">
        {faqs.map((f, i) => (
          <div class={`acc-item ${i === 0 ? 'is-open' : ''}`}>
            <button class="acc-trigger" aria-expanded={i === 0 ? 'true' : 'false'}><span>{f.q}</span><span class="acc-ico" aria-hidden="true"><svg class="acc-ico__d" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg><svg class="acc-ico__u" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg></span></button>
            <div class="acc-panel"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cp-cta">
    <div class="cp-cta__inner">
      <p class="kicker">Ready to start?</p>
      <h2 class="section__title">Begin with Tech+ Fundamentals.</h2>
      <p class="pblock__text" style="margin:1rem auto 0;max-width:52ch">Request information or start your application, and an FEI advisor will help you plan your start date and next steps.</p>
      <div class="cp-cta__actions">
        <a href="/apply" class="btn btn--solid btn--lg" data-apply>Request info</a>
        <a href="/apply" class="btn btn--outline btn--lg" data-apply>Apply now</a>
      </div>
    </div>
  </section>
</BaseLayout>
