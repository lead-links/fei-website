---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Itp1100Body from '../../components/Itp1100Body.astro';
import { COURSE_PREP_LABEL } from '../../data/course-prep';

// Official ITP 1100 course page. It runs the approved Version B content format
// (shared via <Itp1100Body />) and differs from B only in the hero: a photographic
// hero in the site's standard program style, rather than B's blue gradient band.
// IN APPROVAL: noindex + mega menu. Copy is a working DRAFT framed strictly as
// course/exam preparation — nothing final ships before Ramon.
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5z"/></svg>';
---
<BaseLayout
  title={`ITP 1100 — Tech+ Fundamentals (CompTIA ${COURSE_PREP_LABEL}) | Florida Education Institute`}
  description="ITP 1100 Tech+ Fundamentals is a beginner online course at FEI that prepares you for the CompTIA Tech+ (FC0-U71) certification exam across its six domains — four weeks, fully online, with live instructor-led sessions."
  megaMenu
  noindex
>
  <div id="feiProgramMeta" data-program="ITP 1100 — Tech+ Fundamentals" data-program-type="CompTIA Course Prep" hidden></div>

  <div class="ibx" id="top">

    <!-- ==================== HERO (this page's point of difference) ==================== -->
    <section class="phero phero--page">
      <div class="hero__bg" style="background-image:url('/img/course-prep/itp-1100-hero.webp')" aria-hidden="true"></div>
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="phero__inner">
        <div class="phero__copy">
          <p class="eyebrow reveal" data-delay="0"><span class="eyebrow__dot"></span> CompTIA {COURSE_PREP_LABEL} · Foundations</p>
          <h1 class="phero__title reveal" data-delay="1">Tech+ Fundamentals</h1>
          <p class="phero__lede reveal" data-delay="2">A beginner-friendly course that builds your IT foundation and prepares you for the CompTIA Tech+ (FC0-U71) certification exam — computing concepts, infrastructure, applications, software development, data, and security. Four weeks, fully online, with two live sessions a week and small classes of 15 to 20 students.</p>
          <div class="hero__cta reveal" data-delay="3">
            <a href="#enroll" class="btn btn--solid btn--lg">Request enrollment information
              <Fragment set:html={arrow} />
            </a>
            <a href="#plan" class="btn btn--outline btn--lg btn--outline-light">See the 4-week plan</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Version A's own stats bar — the site's standard factbar pattern, kept
         distinct from Version B's .ib-stats band (that one stays in B only). -->
    <aside class="factbar" aria-label="Course at a glance">
      <div class="factbar__inner">
        <div class="factbar__item">
          <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
          <span class="factbar__txt"><strong>ITP 1100</strong><span>Course code · Tech+ Fundamentals</span></span>
        </div>
        <div class="factbar__item">
          <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4-8 4-8-4 8-4z"/><path d="M4 11v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5"/></svg></span>
          <span class="factbar__txt"><strong>CompTIA Tech+ · FC0-U71</strong><span>Prepares for the certification exam</span></span>
        </div>
        <div class="factbar__item">
          <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
          <span class="factbar__txt"><strong>4 weeks · 4 credits</strong><span>Online · Canvas LMS</span></span>
        </div>
        <div class="factbar__item">
          <span class="factbar__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 20h8M12 17v3"/></svg></span>
          <span class="factbar__txt"><strong>2 live sessions / week</strong><span>~60 min each · on Microsoft Teams</span></span>
        </div>
      </div>
    </aside>

    <Itp1100Body />

  </div>
</BaseLayout>
