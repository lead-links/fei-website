---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Itp1100Body from '../../components/Itp1100Body.astro';
import { COURSE_PREP_LABEL } from '../../data/course-prep';

// Version B of the ITP 1100 course page — the APPROVED format. Everything below
// the hero lives in <Itp1100Body />, shared with the official page, which differs
// only in its hero. IN APPROVAL: noindex. Copy is a working DRAFT.
const arrow = '<span class="ib-arw" aria-hidden="true">→</span>';
---
<BaseLayout
  title={`ITP 1100 — Tech+ Fundamentals (Version B · CompTIA ${COURSE_PREP_LABEL}) | Florida Education Institute`}
  description="A four-week online course that gives complete beginners the vocabulary, confidence and technical foundation to start in IT — aligned to the CompTIA Tech+ FC0-U71 V6 exam objectives."
  megaMenu
  noindex
>
  <div id="feiProgramMeta" data-program="ITP 1100 — Tech+ Fundamentals" data-program-type="CompTIA Course Prep" hidden></div>

  <div class="ibx" id="top">

    <!-- ==================== HERO ==================== -->
    <section class="ib-hero">
      <div class="ib-wrap ib-hero__grid">
        <div>
          <div class="ib-hero__tag ib-rv is-in"><i>ITP 1100</i> Computer &amp; Network Technician pathway</div>
          <h1 class="ib-h1 ib-rv is-in ib-d1">Start in IT<br/>from <span class="ib-mark">absolute zero</span>.</h1>
          <p class="ib-hero__lede ib-rv is-in ib-d2">
            Tech+ Fundamentals is a four-week online course that gives complete beginners the
            vocabulary, confidence and technical foundation to move into technology support —
            and prepares you for the CompTIA Tech+ FC0-U71 exam.
          </p>
          <div class="ib-hero__actions ib-rv is-in ib-d3">
            <a class="btn btn--solid btn--lg" href="#enroll">Request enrollment information <Fragment set:html={arrow} /></a>
            <a class="btn btn--outline btn--outline-light btn--lg" href="#plan">See the 4-week plan</a>
          </div>
          <div class="ib-hero__micro ib-rv is-in ib-d4">
            <span>No prerequisites</span>
            <span>100% online</span>
            <span>2 live sessions / week</span>
            <span>Beginner-facing</span>
          </div>
        </div>

        <aside class="ib-spec ib-rv is-in ib-d3" aria-label="Course snapshot">
          <div class="ib-spec__hd">
            <span class="ib-k">Course snapshot</span>
            <div class="ib-spec__v">Tech+ Fundamentals</div>
            <div class="ib-spec__s">First course in the FEI Computer Technician pathway</div>
          </div>
          <dl class="ib-spec__rows">
            <div class="ib-spec__row"><dt>Course code</dt><dd>ITP 1100</dd></div>
            <div class="ib-spec__row"><dt>Length</dt><dd>4 academic weeks</dd></div>
            <div class="ib-spec__row"><dt>Credits</dt><dd>4 credits</dd></div>
            <div class="ib-spec__row"><dt>Format</dt><dd>Online · Canvas LMS</dd></div>
            <div class="ib-spec__row"><dt>Live sessions</dt><dd>2 × ~60 min weekly</dd></div>
            <div class="ib-spec__row"><dt>Platform</dt><dd>Microsoft Teams</dd></div>
            <div class="ib-spec__row"><dt>Aligned to</dt><dd>CompTIA Tech+ FC0-U71 V6</dd></div>
            <div class="ib-spec__row"><dt>Cohort size</dt><dd>15–20 students (max 25)</dd></div>
          </dl>
          <div class="ib-spec__ft">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#0072ce" stroke-width="1.4"/><path d="M8 4.6v4.2M8 11.2v.2" stroke="#0072ce" stroke-width="1.6" stroke-linecap="round"/></svg>
            <span>Certification study, scheduling and testing happen outside the four academic weeks. CompTIA certification is earned only by passing the external exam.</span>
          </div>
        </aside>
      </div>
    </section>


    <Itp1100Body />

  </div>
</BaseLayout>
