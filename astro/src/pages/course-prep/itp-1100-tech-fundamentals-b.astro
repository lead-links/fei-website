---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COURSE_PREP_LABEL } from '../../data/course-prep';

// Version B of the ITP 1100 course page: same STRUCTURE, positions and copy as the
// supplied standalone design, re-skinned to the FEI design system (Montserrat, our
// blue/navy/gold tokens, squared corners, gold primary button) with our own header
// (mega menu) + footer. Hero uses our blue gradient standard. IN APPROVAL: noindex.
// All copy is a working DRAFT — nothing final ships before Ramon.
const arrow = '<span class="ib-arw" aria-hidden="true">→</span>';
---
<BaseLayout
  title={`ITP 1100 — Tech+ Fundamentals (Version B · CompTIA ${COURSE_PREP_LABEL}) | Florida Education Institute`}
  description="A four-week online course that gives complete beginners the vocabulary, confidence and technical foundation to start in IT — aligned to the CompTIA Tech+ FC0-U71 V6 exam objectives."
  megaMenu
  noindex
>
  <div id="feiProgramMeta" data-program="ITP 1100 — Tech+ Fundamentals" data-program-type="CompTIA Course Prep" hidden></div>

  <div class="ibx" id="top">

    <!-- ==================== HERO ==================== -->
    <section class="ib-hero">
      <div class="ib-wrap ib-hero__grid">
        <div>
          <div class="ib-hero__tag ib-rv is-in"><i>ITP 1100</i> Computer &amp; Network Technician pathway</div>
          <h1 class="ib-h1 ib-rv is-in ib-d1">Start in IT<br/>from <span class="ib-mark">absolute zero</span>.</h1>
          <p class="ib-hero__lede ib-rv is-in ib-d2">
            Tech+ Fundamentals is a four-week online course that gives complete beginners the
            vocabulary, confidence and technical foundation to move into technology support —
            and prepares you for the CompTIA Tech+ FC0-U71 exam.
          </p>
          <div class="ib-hero__actions ib-rv is-in ib-d3">
            <a class="btn btn--solid btn--lg" href="#enroll">Request enrollment information <Fragment set:html={arrow} /></a>
            <a class="btn btn--outline btn--outline-light btn--lg" href="#plan">See the 4-week plan</a>
          </div>
          <div class="ib-hero__micro ib-rv is-in ib-d4">
            <span>No prerequisites</span>
            <span>100% online</span>
            <span>2 live sessions / week</span>
            <span>Beginner-facing</span>
          </div>
        </div>

        <aside class="ib-spec ib-rv is-in ib-d3" aria-label="Course snapshot">
          <div class="ib-spec__hd">
            <span class="ib-k">Course snapshot</span>
            <div class="ib-spec__v">Tech+ Fundamentals</div>
            <div class="ib-spec__s">First course in the FEI Computer Technician pathway</div>
          </div>
          <dl class="ib-spec__rows">
            <div class="ib-spec__row"><dt>Course code</dt><dd>ITP 1100</dd></div>
            <div class="ib-spec__row"><dt>Length</dt><dd>4 academic weeks</dd></div>
            <div class="ib-spec__row"><dt>Credits</dt><dd>4 credits</dd></div>
            <div class="ib-spec__row"><dt>Format</dt><dd>Online · Canvas LMS</dd></div>
            <div class="ib-spec__row"><dt>Live sessions</dt><dd>2 × ~60 min weekly</dd></div>
            <div class="ib-spec__row"><dt>Platform</dt><dd>Microsoft Teams</dd></div>
            <div class="ib-spec__row"><dt>Aligned to</dt><dd>CompTIA Tech+ FC0-U71 V6</dd></div>
            <div class="ib-spec__row"><dt>Cohort size</dt><dd>15–20 students (max 25)</dd></div>
          </dl>
          <div class="ib-spec__ft">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#0072ce" stroke-width="1.4"/><path d="M8 4.6v4.2M8 11.2v.2" stroke="#0072ce" stroke-width="1.6" stroke-linecap="round"/></svg>
            <span>Certification study, scheduling and testing happen outside the four academic weeks. CompTIA certification is earned only by passing the external exam.</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- ==================== STATS ==================== -->
    <section class="ib-stats" aria-label="Course at a glance">
      <div class="ib-wrap">
        <div class="ib-stats__grid">
          <div class="ib-stat ib-rv"><b>4<em>×</em></b><span>Academic<br/>instructional weeks</span></div>
          <div class="ib-stat ib-rv ib-d1"><b>4</b><span>College<br/>credits</span></div>
          <div class="ib-stat ib-rv ib-d2"><b>6</b><span>CompTIA Tech+<br/>exam domains</span></div>
          <div class="ib-stat ib-rv ib-d3"><b>2<em>/wk</em></b><span>Instructor-led<br/>live sessions</span></div>
        </div>
      </div>
    </section>

    <!-- ==================== ABOUT ==================== -->
    <section class="ib-band">
      <div class="ib-wrap ib-about__grid">
        <div class="ib-rv">
          <span class="ib-eyebrow">The course</span>
          <h2 class="ib-h2" style="margin-top:20px">A practical foundation, <span class="ib-em">not a firehose</span>.</h2>
          <div class="ib-pull">"Designed for beginners who want a real foundation before moving into hardware, networking, cybersecurity or cloud coursework."</div>
        </div>
        <div class="ib-about__body ib-rv ib-d2">
          <p class="ib-lede">
            Tech+ Fundamentals introduces the core concepts you need to understand modern technology
            and begin an IT education pathway. You explore computing terminology, devices and
            infrastructure, operating systems and applications, basic networking, cloud and
            virtualization concepts, software-development concepts, data and databases,
            troubleshooting, and essential security practices.
          </p>
          <p style="margin-top:22px; color:var(--gray)">
            ITP 1100 is the entry point for the <strong>Computer Technician</strong> and
            <strong>Network Technician</strong> certificates. It helps you build the vocabulary,
            confidence and technical foundation needed for later support courses. The knowledge is
            relevant to entry-level technology-support, help desk, desktop-support and
            computer-technician career paths.
          </p>
          <div class="ib-chiplist">
            <span class="ib-chip">Computing terminology</span>
            <span class="ib-chip">Devices &amp; infrastructure</span>
            <span class="ib-chip">Operating systems</span>
            <span class="ib-chip">Basic networking</span>
            <span class="ib-chip">Cloud &amp; virtualization</span>
            <span class="ib-chip">Software development</span>
            <span class="ib-chip">Data &amp; databases</span>
            <span class="ib-chip">Troubleshooting</span>
            <span class="ib-chip">Security &amp; privacy</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== OUTCOMES ==================== -->
    <section class="ib-band ib-band--wash" id="learn">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv">
          <span class="ib-eyebrow">Learning outcomes</span>
          <h2 class="ib-h2">What you'll be able to do</h2>
          <p class="ib-lede">Six outcomes define what the instructor teaches and what you demonstrate by the end of the course. They shape every assignment, activity and assessment.</p>
        </div>

        <div class="ib-out__grid">
          <article class="ib-out ib-rv">
            <span class="ib-out__n">01 / Concepts</span>
            <h3 class="ib-h3">Explain foundational computing concepts</h3>
            <p>Common technology terminology, measurements, and the standard troubleshooting methodology you'll use for the rest of your career.</p>
          </article>
          <article class="ib-out ib-rv ib-d1">
            <span class="ib-out__n">02 / Hardware</span>
            <h3 class="ib-h3">Identify devices and components</h3>
            <p>Common computing devices, internal components, storage options, peripheral devices, interfaces and basic connectivity tools.</p>
          </article>
          <article class="ib-out ib-rv ib-d2">
            <span class="ib-out__n">03 / Networks</span>
            <h3 class="ib-h3">Describe networking, cloud and OS concepts</h3>
            <p>Basic networking, internet-service, wireless, virtualization, cloud and operating-system concepts used in personal and workplace environments.</p>
          </article>
          <article class="ib-out ib-rv ib-d1">
            <span class="ib-out__n">04 / Software</span>
            <h3 class="ib-h3">Use and configure common software</h3>
            <p>Web-browser features, collaboration tools and basic operating-system features applied in realistic, appropriate scenarios.</p>
          </article>
          <article class="ib-out ib-rv ib-d2">
            <span class="ib-out__n">05 / Data</span>
            <h3 class="ib-h3">Explain data and development fundamentals</h3>
            <p>Introductory software-development, data, database, backup and information-management concepts — the vocabulary behind modern systems.</p>
          </article>
          <article class="ib-out ib-rv ib-d3">
            <span class="ib-out__n">06 / Security</span>
            <h3 class="ib-h3">Apply fundamental security practices</h3>
            <p>Privacy, authentication, passwords, device protection, encryption and small-wireless-network security practices you can use immediately.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ==================== ROADMAP ==================== -->
    <section class="ib-band" id="plan">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv">
          <span class="ib-eyebrow">Module sequence</span>
          <h2 class="ib-h2">Four weeks, <span class="ib-em">one arc</span>.</h2>
          <p class="ib-lede">The course moves from vocabulary to infrastructure to software, and closes with data, security and integrated practice — mirroring how the CompTIA objectives are organized.</p>
        </div>

        <div class="ib-road">
          <div class="ib-road__line" aria-hidden="true"></div>
          <div class="ib-road__track">
            <article class="ib-wk ib-rv">
              <div class="ib-wk__node">01</div>
              <span class="ib-wk__k">Week one</span>
              <h3 class="ib-h3">IT Concepts, Terminology &amp; Practical Troubleshooting</h3>
              <p>Establish the vocabulary and problem-solving method used throughout the course: input, processing, output, storage, number systems, measurements, devices and troubleshooting steps.</p>
              <div class="ib-wk__bar"></div>
            </article>
            <article class="ib-wk ib-rv ib-d1">
              <div class="ib-wk__node">02</div>
              <span class="ib-wk__k">Week two</span>
              <h3 class="ib-h3">Infrastructure, Devices, Connectivity, Virtualization &amp; Networking</h3>
              <p>Build confidence with internal components, storage, peripherals, device interfaces, internet services, basic networking and wireless concepts, and introductory cloud/virtualization.</p>
              <div class="ib-wk__bar"></div>
            </article>
            <article class="ib-wk ib-rv ib-d2">
              <div class="ib-wk__node">03</div>
              <span class="ib-wk__k">Week three</span>
              <h3 class="ib-h3">Applications, Operating Systems, Web Tools &amp; Software Development</h3>
              <p>Understand operating systems, software types, browser configuration, productivity and collaboration tools, AI use cases and introductory programming logic.</p>
              <div class="ib-wk__bar"></div>
            </article>
            <article class="ib-wk ib-rv ib-d3">
              <div class="ib-wk__node">04</div>
              <span class="ib-wk__k">Week four</span>
              <h3 class="ib-h3">Data, Databases, Security, Review &amp; Integrated Practice</h3>
              <p>Data and backup concepts, databases, security and privacy, passwords, encryption, wireless security, troubleshooting integration and objective-aligned review.</p>
              <div class="ib-wk__bar"></div>
            </article>
          </div>

          <div class="ib-ongoing ib-rv ib-d2">
            <span class="ib-ongoing__k">Ongoing · every week</span>
            <p><b>Objective-aligned knowledge checks and student support.</b> Canvas quizzes, guided practice, live questions and early outreach are used to identify weak areas <em>before</em> you move into the next pathway course — not after you've already fallen behind.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== WEEK RHYTHM ==================== -->
    <section class="ib-band ib-band--wash" id="week">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv">
          <span class="ib-eyebrow">Delivery structure</span>
          <h2 class="ib-h2">What a normal week feels like</h2>
          <p class="ib-lede">The same reliable experience every week, regardless of who is teaching. This is how an outline becomes a consistent student experience.</p>
        </div>

        <div class="ib-rhythm__grid">
          <div class="ib-panel ib-rv">
            <span class="ib-eyebrow">Your week</span>
            <h3 class="ib-h3">Weekly learning experience</h3>
            <ul class="ib-tick">
              <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Two instructor-led online sessions</b> of approximately 60 minutes each, delivered live on Microsoft Teams.</span></li>
              <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Canvas modules</b> with the approved study guide, objective-aligned knowledge checks and guided examples.</span></li>
              <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Practical demonstrations</b> connecting concepts to real technology you already use.</span></li>
              <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>A clear weekly roadmap</b> with due dates and an obvious way to ask questions or request help.</span></li>
              <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Recorded sessions or equivalent materials</b> provided when available and consistent with FEI policy.</span></li>
            </ul>
          </div>

          <div class="ib-panel ib-rv ib-d2">
            <span class="ib-eyebrow">Instructor commitment</span>
            <h3 class="ib-h3">What your instructor owes you</h3>
            <ul class="ib-slalist">
              <li><span>Welcome and access check</span><b>Course start</b></li>
              <li><span>Course update posted</span><b>Weekly</b></li>
              <li><span>Answer to student questions</span><b>1–2 business days</b></li>
              <li><span>Grading and feedback returned</span><b>3–5 business days</b></li>
              <li><span>Missing work &amp; low quiz monitoring</span><b>Continuous</b></li>
              <li><span>Outreach to at-risk students</span><b>Proactive</b></li>
              <li><span>Transition plan to ITP 1200</span><b>End of course</b></li>
            </ul>
            <div class="ib-notice" style="margin-top:26px">
              <span class="ib-notice__i"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.6l6 3v4c0 3.2-2.6 5.3-6 5.8-3.4-.5-6-2.6-6-5.8v-4l6-3z" stroke="#8A6100" stroke-width="1.3" stroke-linejoin="round"/></svg></span>
              <p>The instructor delivers the live sessions, guides learning, answers questions, and helps you resolve any technical or academic barriers along the way.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PATHWAY ==================== -->
    <section class="ib-band ib-band--ink">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv" style="max-width:720px">
          <span class="ib-eyebrow ib-on-dark">Career pathway</span>
          <h2 class="ib-h2" style="color:#fff">Where ITP 1100 takes you</h2>
          <p class="ib-lede" style="color:rgba(255,255,255,.72)">This course is deliberately the first step — broad, beginner-facing, and built so the next courses don't have to start from scratch.</p>
        </div>

        <div class="ib-path">
          <article class="ib-step ib-step--now ib-rv">
            <span class="ib-step__k">You are here</span>
            <h3 class="ib-h3">ITP 1100 · Tech+ Fundamentals</h3>
            <p>4 weeks · 4 credits. Vocabulary, devices, networking, software, data and security foundations.</p>
          </article>
          <article class="ib-step ib-rv ib-d1">
            <span class="ib-step__k">Next course</span>
            <h3 class="ib-h3">ITP 1200 · Computer Hardware &amp; Support</h3>
            <p>Deeper hardware and operating-system content. A grade of C or higher in ITP 1100 lets you progress.</p>
          </article>
          <article class="ib-step ib-rv ib-d2">
            <span class="ib-step__k">Then</span>
            <h3 class="ib-h3">Support, security &amp; cloud coursework</h3>
            <p>Continue into networking, cybersecurity or cloud-support courses within the FEI technology programs.</p>
          </article>
        </div>

        <div class="ib-certs ib-rv ib-d2">
          <div class="ib-cert"><span class="ib-cert__code">ITC-1000</span><span>Computer Technician Certificate</span></div>
          <div class="ib-cert"><span class="ib-cert__code">ITC-2000</span><span>Network Technician Certificate</span></div>
        </div>
      </div>
    </section>

    <!-- ==================== EXAM ==================== -->
    <section class="ib-band" id="exam">
      <div class="ib-wrap ib-exam__grid">
        <div class="ib-rv">
          <span class="ib-eyebrow">Certification preparation</span>
          <h2 class="ib-h2" style="margin:20px 0 20px">Course completion and <span class="ib-em">certification</span> are two different things.</h2>
          <p class="ib-lede">
            Passing ITP 1100 earns you FEI academic credit toward your certificate. The CompTIA Tech+
            certification is earned only by passing the external exam at a testing center. This course
            prepares you for it — it does not replace it.
          </p>

          <ul class="ib-tick" style="margin-top:30px">
            <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Instructor-led objective review</b> across all six exam domains.</span></li>
            <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Canvas practice quizzes</b> plus guided explanation of the concepts you miss.</span></li>
            <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Remediation for weak domains</b> identified from your practice results.</span></li>
            <li><span class="ib-dot"><svg width="9" height="7" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4l2.6 2.6L9 1.2" stroke="#8A6100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>A readiness benchmark:</b> 85% on two separate objective-aligned practice assessments, plus instructor review of weak areas.</span></li>
          </ul>

          <div class="ib-notice">
            <span class="ib-notice__i"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.6" stroke="#8A6100" stroke-width="1.3"/><path d="M8 4.8v4M8 10.9v.2" stroke="#8A6100" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            <p><b>No guarantees, by design.</b> FEI does not promise employment or a certification result. Exam scheduling depends on your readiness, voucher policy and Pearson VUE availability.</p>
          </div>
        </div>

        <div class="ib-examcard ib-rv ib-d2">
          <div class="ib-examcard__hd">
            <b>CompTIA Tech+</b>
            <span>FC0-U71 · V6</span>
          </div>
          <div class="ib-examnums">
            <div><b>70</b><span>Questions max</span></div>
            <div><b>60</b><span>Minutes</span></div>
            <div><b>650</b><span>Passing score</span></div>
          </div>
          <div class="ib-domains">
            <span class="ib-k">Six exam domains</span>
            <ol>
              <li>IT Concepts and Terminology</li>
              <li>Infrastructure</li>
              <li>Applications and Software</li>
              <li>Software Development Concepts</li>
              <li>Data and Database Fundamentals</li>
              <li>Security</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== REQUIREMENTS ==================== -->
    <section class="ib-band ib-band--wash" id="requirements">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv">
          <span class="ib-eyebrow">Before you enroll</span>
          <h2 class="ib-h2">What you need to start</h2>
          <p class="ib-lede">Short list. This is a beginner course — the requirements are about access and time, not prior technical experience.</p>
        </div>

        <div class="ib-req__grid">
          <article class="ib-req ib-rv">
            <span class="ib-req__ico"><svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2.2l7 3.4-7 3.4-7-3.4 7-3.4z" stroke="#0072ce" stroke-width="1.4" stroke-linejoin="round"/><path d="M4.4 8.2v4.4c0 1.5 2.5 2.8 5.6 2.8s5.6-1.3 5.6-2.8V8.2" stroke="#0072ce" stroke-width="1.4" stroke-linecap="round"/></svg></span>
            <h3 class="ib-h3">No prerequisites</h3>
            <p>ITP 1100 is the recommended starting point for students new to technology or to formal IT study. Nothing is required before it.</p>
            <span class="ib-req__flag">Beginner level</span>
          </article>

          <article class="ib-req ib-rv ib-d1">
            <span class="ib-req__ico"><svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.4" y="3.6" width="15.2" height="10" rx="1.4" stroke="#0072ce" stroke-width="1.4"/><path d="M1.4 16.4h17.2" stroke="#0072ce" stroke-width="1.4" stroke-linecap="round"/></svg></span>
            <h3 class="ib-h3">A real computer</h3>
            <p>A reliable laptop or desktop, stable internet, a modern browser and a headset or microphone and speakers. A mobile phone alone is not enough to complete the course.</p>
            <span class="ib-req__flag">Access check in week 1</span>
          </article>

          <article class="ib-req ib-rv ib-d2">
            <span class="ib-req__ico"><svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 3.2h9l3.2 3.2v10.4H4V3.2z" stroke="#0072ce" stroke-width="1.4" stroke-linejoin="round"/><path d="M7 9.4h6M7 12.4h4" stroke="#0072ce" stroke-width="1.4" stroke-linecap="round"/></svg></span>
            <h3 class="ib-h3">The approved study guide</h3>
            <p>An FEI-approved CompTIA Tech+ study guide aligned to FC0-U71 V6 is the primary required learning material, alongside Canvas quizzes and practice questions.</p>
            <span class="ib-req__flag">Title confirmed at launch</span>
          </article>

          <article class="ib-req ib-rv ib-d3">
            <span class="ib-req__ico"><svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7.4" stroke="#0072ce" stroke-width="1.4"/><path d="M10 5.6V10l2.8 2" stroke="#0072ce" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <h3 class="ib-h3">Time to show up</h3>
            <p>Basic digital literacy plus time to attend the live sessions and complete coursework. Attendance and independent study outside class are part of the design.</p>
            <span class="ib-req__flag">80% attendance standard</span>
          </article>
        </div>
      </div>
    </section>

    <!-- ==================== SUPPORT ==================== -->
    <section class="ib-band">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv">
          <span class="ib-eyebrow">Student success</span>
          <h2 class="ib-h2">Where students struggle — and <span class="ib-em">what we do about it</span></h2>
          <p class="ib-lede">These are the three failure points the course plan names explicitly, each with a defined response. Support is scheduled, not improvised.</p>
        </div>

        <div class="ib-sup">
          <div class="ib-sup__row ib-rv">
            <div><span class="ib-sup__k">Risk area</span><h3 class="ib-h3">Broad scope and unfamiliar terminology</h3></div>
            <div><span class="ib-sup__k">Why it matters</span><p class="ib-why">Tech+ spans hardware, networks, software development, data, cloud and security. New students often can't see how the topics connect.</p></div>
            <div><span class="ib-sup__k">The response</span><p class="ib-fix">A domain roadmap and simple glossary from day one, weekly objective maps, real-world examples, short knowledge checks and a running list of terms you should be able to explain.</p></div>
          </div>

          <div class="ib-sup__row ib-rv ib-d1">
            <div><span class="ib-sup__k">Risk area</span><h3 class="ib-h3">Confidence and study habits</h3></div>
            <div><span class="ib-sup__k">Why it matters</span><p class="ib-why">Students new to formal technology study may fear technical vocabulary or underestimate the time needed outside live sessions.</p></div>
            <div><span class="ib-sup__k">The response</span><p class="ib-fix">Clear weekly expectations, modeling of how to study certification objectives, early low-stakes quizzes, outreach after missed work or low scores, and a brief instructor check-in or study plan.</p></div>
          </div>

          <div class="ib-sup__row ib-rv ib-d2">
            <div><span class="ib-sup__k">Risk area</span><h3 class="ib-h3">Device, internet and platform readiness</h3></div>
            <div><span class="ib-sup__k">Why it matters</span><p class="ib-why">Relying only on a phone or an unstable connection makes Canvas activities, live sessions and practice assessments difficult.</p></div>
            <div><span class="ib-sup__k">The response</span><p class="ib-fix">An early access and technology check, a clear FEI support route, a reminder of minimum device needs, and documented accommodations or campus-equipment options where approved.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FAQ ==================== -->
    <section class="ib-band ib-band--wash" id="faq">
      <div class="ib-wrap">
        <div class="ib-sec-head ib-rv" style="margin-inline:auto; text-align:center; max-width:640px">
          <span class="ib-eyebrow" style="justify-content:center">Questions</span>
          <h2 class="ib-h2">Before you ask</h2>
        </div>

        <div class="ib-faq ib-rv ib-d1">
          <details open>
            <summary>Do I need any technical experience to enroll?</summary>
            <div class="ib-ans">No. ITP 1100 has <b>no required prerequisites</b> and is the recommended starting point for students new to technology or to formal IT study. You should have basic digital literacy, reliable access to a computer and internet, and time to participate in live sessions and complete coursework.</div>
          </details>

          <details>
            <summary>How much time does the course take?</summary>
            <div class="ib-ans">The course runs for <b>four academic instructional weeks</b>. Each week includes two instructor-led live sessions of approximately 60 minutes, plus Canvas modules, knowledge checks, guided examples and independent study. Certification study and testing happen outside those four weeks.</div>
          </details>

          <details>
            <summary>Does finishing the course give me the CompTIA certification?</summary>
            <div class="ib-ans">No — and this distinction matters. <b>FEI academic completion is separate from CompTIA certification testing.</b> You earn FEI certificates through required coursework, cumulative GPA and attendance. You earn the CompTIA Tech+ certification only by passing the external exam.</div>
          </details>

          <details>
            <summary>When should I take the Tech+ exam?</summary>
            <div class="ib-ans">You're encouraged to plan testing <b>after completing ITP 1100 and adequate independent review</b>. The recommended readiness benchmark is at least 85% on two separate objective-aligned practice assessments plus instructor review of any weak domains. The actual timeline depends on your readiness, voucher policy and Pearson VUE scheduling.</div>
          </details>

          <details>
            <summary>What do I need to pass the course and move on?</summary>
            <div class="ib-ans">To pass, complete the required course activities, maintain at least <b>80% cumulative attendance</b>, and maintain a <b>cumulative GPA of 2.0 or higher</b>. A grade of <b>C or higher</b> lets you progress to ITP 1200 — Computer Hardware and Support.</div>
          </details>

          <details>
            <summary>Can I skip ITP 1100 if I already work in tech?</summary>
            <div class="ib-ans">Advanced entry is possible. Students seeking to bypass ITP 1100 for entry into later courses may submit <b>documented equivalent college coursework, relevant experience, or an active related credential</b> for review. Exceptions are decided by the instructor of record or a designated FEI academic or program administrator.</div>
          </details>

          <details>
            <summary>What if I only have a smartphone?</summary>
            <div class="ib-ans">A mobile phone alone <b>should not be your primary device</b> for course completion. Canvas activities, live sessions, practice assessments and file-based work all need a laptop or desktop. Talk to FEI before enrolling — accommodations or campus-equipment options may be available.</div>
          </details>

          <details>
            <summary>How large are the classes?</summary>
            <div class="ib-ans">The cohort target is <b>15–20 students</b>, with a maximum of <b>25 students</b> per instructor cohort — small enough for the instructor to monitor progress and reach out to at-risk students individually.</div>
          </details>
        </div>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="ib-cta ib-band" id="enroll">
      <div class="ib-cta__glow" aria-hidden="true"></div>
      <div class="ib-wrap ib-cta__inner">
        <div class="ib-rv">
          <span class="ib-eyebrow ib-on-dark">Next cohort</span>
          <h2 class="ib-h2" style="color:#fff; margin-top:20px">Four weeks from now,<br/>none of this is <span class="ib-em" style="color:var(--gold)">unfamiliar</span>.</h2>
          <p>Request enrollment information for ITP 1100 — Tech+ Fundamentals and an FEI advisor will walk you through start dates, live-session schedule, materials and tuition.</p>
        </div>
        <div class="ib-rv ib-d2">
          <div class="ib-cta__actions">
            <a class="btn btn--solid btn--lg" href="mailto:admissions@fei.edu?subject=ITP%201100%20-%20Tech%2B%20Fundamentals">Request enrollment information <Fragment set:html={arrow} /></a>
            <a class="btn btn--outline btn--outline-light btn--lg" href="#plan">Review the 4-week plan</a>
          </div>
          <p class="ib-cta__note">
            Your advisor will cover the cohort start date, live-session days and times,<br/>
            and your tuition and testing-fee options.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ============================================================
     ITP 1100 · Version B — same structure/positions/copy as the
     supplied design, re-skinned to the FEI design system.
     Namespaced .ib-* so nothing collides with global styles.
     ============================================================ */
  .ibx {
    --ib-ink: var(--navy);
    --ib-ink2: #1159af;
    --ib-slate: var(--gray);
