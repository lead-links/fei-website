  /* Gold underline sits mostly BELOW the letters (not a highlighter block behind
     them), so "absolute zero" stays white — same color as the rest of the H1 — and
     always reads clearly against the dark hero, with the gold as a decorative accent. */
  .ib-mark { position: relative; display: inline-block; z-index: 1; white-space: nowrap; color: #fff; }
  .ib-mark::after {
    content: ""; position: absolute; z-index: -1; left: -.06em; right: -.06em; bottom: -.06em; height: .16em;
    background: var(--gold); transform: skewX(-11deg) scaleX(0); transform-origin: left center;
    animation: ib-swipe .78s var(--ease) .55s forwards;
