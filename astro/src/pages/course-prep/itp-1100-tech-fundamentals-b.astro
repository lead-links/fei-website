    --ib-shadow: 0 2px 4px rgba(17, 37, 80, .04), 0 18px 40px -20px rgba(17, 37, 80, .22);
    --ib-shadow-lg: 0 30px 70px -34px rgba(17, 37, 80, .42);
    color: var(--ib-ink);
  }
  .ibx :where(h1, h2, h3, h4) { font-family: var(--display); font-weight: 800; letter-spacing: -.02em; line-height: 1.08; margin: 0; }
  .ib-h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.08; letter-spacing: -.03em; color: #fff; }
  .ib-h2 { font-size: clamp(1.9rem, 4.2vw, 3.1rem); letter-spacing: -.03em; color: var(--ib-ink); }
  .ib-h3 { font-size: clamp(1.1rem, 1.7vw, 1.35rem); line-height: 1.22; }
  .ibx p { margin: 0; }
  .ib-em { font-style: italic; font-weight: 700; }

  .ib-wrap { width: 100%; max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .ib-band { position: relative; padding-block: clamp(72px, 9vw, 128px); }
  .ib-band--wash { background: var(--ib-wash2); border-block: 1px solid var(--ib-line-soft); }
  .ib-band--ink { background: var(--navy); color: #fff; }

  .ib-eyebrow {
    font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
    color: var(--blue-600); display: inline-flex; align-items: center; gap: .65em;
  }
  .ib-eyebrow::before { content: ""; width: 8px; height: 8px; background: var(--gold); transform: rotate(45deg); flex: none; }
  .ib-eyebrow.ib-on-dark { color: var(--gold); }

  .ib-lede { font-size: clamp(1.02rem, 1.4vw, 1.18rem); color: var(--ib-slate); line-height: 1.62; max-width: 62ch; }
  .ib-sec-head { max-width: 760px; margin-bottom: clamp(38px, 5vw, 60px); }
  .ib-sec-head .ib-eyebrow { margin-bottom: 20px; }
  .ib-sec-head h2 { margin-bottom: 20px; }

  /* ---------- HERO (blue, our standard) ---------- */
  /* Abstract technology texture behind the brand gradient. The gradient stays
     dominant (high alpha) so the white headline and lede keep their contrast —
     the image reads as depth, not as a photo competing with the copy. */
  .ib-hero {
    position: relative;
    padding-top: clamp(150px, 20vh, 220px);
    padding-bottom: clamp(60px, 8vw, 110px);
    background:
      linear-gradient(100deg, rgba(17, 37, 80, .94) 0%, rgba(22, 58, 118, .88) 52%, rgba(27, 72, 144, .82) 100%),
      url('/img/course-prep/itp-1100-b-hero-abstract.webp') center / cover no-repeat;
    color: #fff; overflow: hidden;
  }
  .ib-hero__grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.16fr) minmax(0, .84fr); gap: clamp(34px, 5vw, 76px); align-items: center; }
  .ib-hero__tag {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
