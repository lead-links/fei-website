  /* ---------- EXAM ---------- */
  .ib-exam__grid { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr); gap: clamp(30px, 4.4vw, 68px); align-items: center; }
  .ib-examcard { background: #fff; border: 1px solid var(--ib-line); overflow: hidden; box-shadow: var(--ib-shadow); }
  .ib-examcard__hd { background: var(--navy); color: #fff; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .ib-examcard__hd b { font-family: var(--display); font-size: 1.06rem; font-weight: 700; letter-spacing: -.02em; }
