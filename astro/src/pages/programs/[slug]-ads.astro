---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROGRAM_META } from '../../data/program-meta';
import { PROGRAMS } from '../../data/programs';
import CtaBlock from '../../components/CtaBlock.astro';

// Preview copies of the program pages, for the client to approve the new wording
// before it goes onto the official URL. Same layout and same components as the
// real page — only the copy in data/programs/ads/<slug>.html differs.
//
// noindex, always: seven near-identical pages in the index would compete with the
// pages they are meant to replace.
//
// ADS KEEP POINTING AT THE OFFICIAL URL. Sending campaign traffic here would
// start a fresh Quality Score history on a new URL, which is the opposite of why
// this rewrite exists — the score has to accumulate on the page the keywords
// already run against.
//
// Once a page is approved, its content moves into data/programs/<slug>.html and
// the entry below is removed.
const ADS_PAGES = ['pharmacy-technician'];

const contents = import.meta.glob('../../data/programs/ads/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export function getStaticPaths() {
  return ['pharmacy-technician'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = PROGRAM_META[slug as string];
const key = Object.keys(contents).find((k) => k.endsWith(`/${slug}.html`))!;
const html = contents[key];

// The Apply modal reads these to fill its hidden fields. Looked up by the BASE
// slug, so a lead from a preview page still carries the right programme.
const program = PROGRAMS.find((p) => p.slug === slug);
const programType = program?.tag === 'A.A.S.' ? 'Associate Degree' : (program?.tag ?? '');
---
<BaseLayout title={`${meta.title} — preview`} description={meta.description} noindex>
  {program && (
    <div id="feiProgramMeta" data-program={program.title} data-program-type={programType} hidden></div>
  )}
  <Fragment set:html={html} />
  <CtaBlock />
</BaseLayout>
