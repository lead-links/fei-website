---
import LangSwitch from './LangSwitch.astro';
import { href, locales, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { IT_GROUPS, coursesByGroup, COURSE_PREP_LABEL } from '../data/course-prep';
import { PROGRAMS, CAT_LABELS } from '../data/programs';

// i18n-aware chrome. English at the root, Spanish under /es/ with localized slugs.
// Use locales() so the .html/trailing-slash forms (e.g. /es.html) are detected too.
// `mega` swaps the Programs item for the CompTIA "Course Prep" mega menu — used only
// on the (noindex, in-approval) /course-prep pages, so the live site nav is untouched.
interface Props { forceStuck?: boolean; mega?: boolean }
const { forceStuck = false, mega = false } = Astro.props;
const isEs = locales(Astro.url.pathname).isEs;
const lang: Lang = isEs ? 'es' : 'en';
const s = t(lang).nav;
const home = isEs ? '/es' : '/';
const links = [
  { href: href('/programs', lang), label: s.programs },
  { href: href('/about', lang), label: s.about },
  { href: href('/admissions', lang), label: s.admissions },
  { href: href('/financial-aid', lang), label: s.financialAid },
  { href: href('/support', lang), label: s.support },
  { href: href('/blog', lang), label: s.blog },
];
const applyHref = href('/apply', lang);
// Mega-menu columns. Programs are grouped by category; the two small categories
// (Business, Skilled Trades) stack in one column, as do the two small IT tracks.
const byCat = (c: string) => PROGRAMS.filter((p) => p.cat === c);
const itGroup = (k: string) => IT_GROUPS.find((g) => g.key === k)!;
---
<div class="utility-bar">
  <div class="utility-bar__inner">
    <a href="tel:3054441515" class="utility-bar__phone">{s.callToday}</a>
    <span class="utility-bar__sep" aria-hidden="true">|</span>
    <a href="https://starnet.neolms.com/" target="_blank" rel="noopener" class="utility-bar__link">{s.studentPortal}</a>
    <span class="utility-bar__sep" aria-hidden="true">|</span>
    <LangSwitch />
  </div>
</div>

<header class={`nav ${forceStuck ? 'is-stuck' : ''}`} id="nav" data-force-stuck={forceStuck ? 'true' : undefined}>
  <div class="nav__inner">
    <a href={home} class="brand" aria-label={s.home}>
      <span class="brand__mark" aria-hidden="true">
        <img class="brand__logo" src="/fei-logo.png" alt="Florida Education Institute" width="54" height="50" />
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {mega ? (
        <Fragment>
          <div class="nav__mega">
            <button class="nav__mega-trigger" id="megaTrigger" type="button" aria-expanded="false" aria-controls="megaPanel" aria-haspopup="dialog">Programs &amp; Courses
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          {links.slice(1).map((l) => <a href={l.href}>{l.label}</a>)}
        </Fragment>
      ) : (
        links.map((l) => <a href={l.href}>{l.label}</a>)
      )}
    </nav>

    <div class="nav__actions">
      <a href={applyHref} class="btn btn--solid" data-apply>{s.apply}</a>
    </div>

    <LangSwitch extraClass="nav__mobile-lang" />

    <button class="nav__toggle" id="navToggle" aria-label={s.openMenu} aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <button class="mobile-menu__close" type="button" aria-label={s.closeMenu}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {mega && <a href="/course-prep">{COURSE_PREP_LABEL} · CompTIA</a>}
    <a href={applyHref} class="btn btn--solid" data-apply>{s.apply}</a>
  </div>
</header>

{mega && (
  <Fragment>
    {/* Centred popover, opened by #megaTrigger. Rendered OUTSIDE <header> so it is
        not trapped in the nav's stacking context (the utility bar sits above it). */}
    <div class="mega-scrim" id="megaScrim" hidden></div>
    <div class="mega-panel" id="megaPanel" role="dialog" aria-modal="true" aria-label="Programs and courses" aria-hidden="true">
      <button class="mega-panel__close" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      {/* ── Section 1: the career programs ── */}
      <section class="mega-sec">
        <div class="mega-cols">
          <div class="mega-col">
            <p class="mega-col__head">FEI Programs</p>
            <ul class="mega-lead">
              <li><a href="/programs">Explore All Programs</a></li>
            </ul>
            <p class="mega-col__lede">Our career-focused diploma and associate degree programs.</p>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{CAT_LABELS.health}</p>
            <ul class="mega-list">
              {byCat('health').map((p) => <li><a href={`/programs/${p.slug}`}>{p.title}</a></li>)}
            </ul>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{CAT_LABELS.culinary}</p>
            <ul class="mega-list">
              {byCat('culinary').map((p) => <li><a href={`/programs/${p.slug}`}>{p.title}</a></li>)}
            </ul>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{CAT_LABELS.business}</p>
            <ul class="mega-list">
              {byCat('business').map((p) => <li><a href={`/programs/${p.slug}`}>{p.title}</a></li>)}
            </ul>
            <p class="mega-col__head mega-col__head--stacked">{CAT_LABELS.trades}</p>
            <ul class="mega-list">
              {byCat('trades').map((p) => <li><a href={`/programs/${p.slug}`}>{p.title}</a></li>)}
            </ul>
          </div>
        </div>
      </section>

      {/* ── Section 2: the CompTIA exam-prep courses ── */}
      <section class="mega-sec">
        <div class="mega-cols">
          <div class="mega-col">
            <p class="mega-col__head">{COURSE_PREP_LABEL} · CompTIA</p>
            <ul class="mega-lead">
              <li><a href="/course-prep">Explore All Courses</a></li>
            </ul>
            <p class="mega-col__lede">Instructor-led courses that prepare you for the CompTIA certification exams.</p>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{itGroup('foundations').name}<span>{itGroup('foundations').exam}</span></p>
            <ul class="mega-list">
              {coursesByGroup('foundations').map((c) => (
                <li><a href={c.built ? `/course-prep/${c.slug}` : '/course-prep'}><span>{c.code}</span> {c.title}</a></li>
              ))}
            </ul>
            <p class="mega-col__head mega-col__head--stacked">{itGroup('computer-technician').name}<span>{itGroup('computer-technician').exam}</span></p>
            <ul class="mega-list">
              {coursesByGroup('computer-technician').map((c) => (
                <li><a href={c.built ? `/course-prep/${c.slug}` : '/course-prep'}><span>{c.code}</span> {c.title}</a></li>
              ))}
            </ul>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{itGroup('networking-technician').name}<span>{itGroup('networking-technician').exam}</span></p>
            <ul class="mega-list">
              {coursesByGroup('networking-technician').map((c) => (
                <li><a href={c.built ? `/course-prep/${c.slug}` : '/course-prep'}><span>{c.code}</span> {c.title}</a></li>
              ))}
            </ul>
          </div>
          <div class="mega-col">
            <p class="mega-col__head">{itGroup('cybersecurity').name}<span>{itGroup('cybersecurity').exam}</span></p>
            <ul class="mega-list">
              {coursesByGroup('cybersecurity').map((c) => (
                <li><a href={c.built ? `/course-prep/${c.slug}` : '/course-prep'}><span>{c.code}</span> {c.title}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </div>
  </Fragment>
)}
