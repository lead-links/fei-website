---
import { getCollection } from 'astro:content';
import { PROGRAMS, CAT_LABELS } from '../data/programs';
import { PAGE_ES, PROGRAM_ES, PROGRAM_TITLE_ES, CAT_LABELS_ES, type Lang } from '../i18n/routes';

// Shared body for /sitemap (EN) and /es/mapa-del-sitio (ES) — the human-readable,
// navigable site directory (distinct from the machine /sitemap.xml). Everything
// is expanded except Blog, which lists categories with post counts that expand
// to the posts (reuses the site's .accordion/.acc-item — same markup + JS as the
// FAQ pattern, so no new script). The Blog has no Spanish content at all, so the
// ES page just omits that section rather than showing English posts there.
// Each row links to ONE page in the current page's own language (no second
// same-row link to the other language — the header's EN/ES switcher already
// covers that); a small arrow after the text is just a "this is clickable" cue.
interface Props { lang: Lang }
const { lang } = Astro.props;
const isEs = lang === 'es';

const STRINGS = isEs
  ? {
      kicker: 'Navegar', title: 'Mapa del sitio', lede: 'Todas las páginas de fei.edu, en un solo lugar.',
      mainPages: 'Páginas principales', programs: 'Programas',
    }
  : {
      kicker: 'Navigate', title: 'Sitemap', lede: 'Every page on fei.edu, in one place.',
      mainPages: 'Main pages', programs: 'Programs',
    };

// Main pages: one canonical EN-keyed list with both labels, so the two pages
// can never drift out of sync with each other or with the real PAGE_ES map.
const MAIN_PAGES_SRC = [
  { en: '/', enLabel: 'Home', esLabel: 'Inicio' },
  { en: '/programs', enLabel: 'Programs', esLabel: 'Programas' },
  { en: '/about', enLabel: 'About FEI', esLabel: 'Sobre FEI' },
  { en: '/admissions', enLabel: 'Admissions', esLabel: 'Admisiones' },
  { en: '/apply', enLabel: 'Apply Now', esLabel: 'Inscríbete' },
  { en: '/employers', enLabel: 'For Employers', esLabel: 'Para Empleadores' },
  { en: '/financial-aid', enLabel: 'Financial Aid', esLabel: 'Ayuda Financiera' },
  { en: '/support', enLabel: 'Support', esLabel: 'Apoyo' },
  { en: '/blog', enLabel: 'Blog', esLabel: null }, // English-only, no ES page
  { en: '/legal/privacy', enLabel: 'Privacy Policy', esLabel: 'Política de Privacidad' },
  { en: '/legal/terms', enLabel: 'Terms of Service', esLabel: 'Términos de Servicio' },
  { en: '/consumer-information', enLabel: 'Consumer Information', esLabel: 'Información al Consumidor' },
];
const MAIN_PAGES = MAIN_PAGES_SRC.map((p) => {
  const es = p.esLabel ? (PAGE_ES[p.en] ?? null) : null;
  return {
    href: isEs && es ? es : p.en,
    label: isEs && p.esLabel ? p.esLabel : p.enLabel,
  };
});

const CAT_ORDER = Object.keys(CAT_LABELS) as (keyof typeof CAT_LABELS)[];
const programsByCat = CAT_ORDER.map((cat) => ({
  cat,
  label: isEs ? CAT_LABELS_ES[cat] : CAT_LABELS[cat],
  items: PROGRAMS.map((p) => ({
    ...p,
    href: isEs ? `/es/programas/${PROGRAM_ES[p.slug]}` : `/programs/${p.slug}`,
    label: isEs ? PROGRAM_TITLE_ES[p.slug] : p.title,
  })).filter((p) => p.cat === cat),
}));

// Blog has no Spanish content — only build/show this section on the EN page.
const blogCategories = isEs ? [] : await (async () => {
  const posts = (await getCollection('blog')).sort(
    (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
  );
  const catMap = new Map<string, { name: string; posts: typeof posts }>();
  posts.forEach((p) =>
    p.data.categories.forEach((c) => {
      if (!catMap.has(c.slug)) catMap.set(c.slug, { name: c.name, posts: [] as typeof posts });
      catMap.get(c.slug)!.posts.push(p);
    })
  );
  return Array.from(catMap.entries())
    .map(([slug, v]) => ({ slug, name: v.name, posts: v.posts }))
    .sort((a, b) => b.posts.length - a.posts.length);
})();

const dateFmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const arrow = '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5z"/></svg>';
---
<div class="sm">
  <section class="sm-head">
    <p class="kicker">{STRINGS.kicker}</p>
    <h1 class="section__title">{STRINGS.title}</h1>
    <p class="sm-head__lede">{STRINGS.lede}</p>
  </section>

  <!-- MAIN PAGES -->
  <section class="sm-section">
    <h2 class="sm-section__title">{STRINGS.mainPages}</h2>
    <ul class="sm-list">
      {MAIN_PAGES.map((p) => (
        <li class="sm-row">
          <a href={p.href} class="sm-row__link">{p.label}<Fragment set:html={arrow} /></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- PROGRAMS -->
  <section class="sm-section">
    <h2 class="sm-section__title">{STRINGS.programs}</h2>
    <div class="sm-cat-grid">
      {programsByCat.map((group) => (
        <div class="sm-cat">
          <p class="sm-cat__name">{group.label}</p>
          <ul class="sm-list">
            {group.items.map((p) => (
              <li class="sm-row">
                <a href={p.href} class="sm-row__link">{p.label}<Fragment set:html={arrow} /></a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- BLOG (EN only — no Spanish content, see note above) -->
  {!isEs && blogCategories.length > 0 && (
    <section class="sm-section">
      <h2 class="sm-section__title">
        Blog
        <a href="/blog" class="sm-section__all">View all posts →</a>
      </h2>
      <div class="accordion sm-blog-accordion" id="sitemapBlogAccordion">
        {blogCategories.map((cat, i) => (
          <div class={`acc-item ${i === 0 ? 'is-open' : ''}`}>
            <button class="acc-trigger" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span>{cat.name} <span class="sm-cat-count">({cat.posts.length})</span></span>
              <span class="acc-ico" aria-hidden="true">
                <svg class="acc-ico__d" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                <svg class="acc-ico__u" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>
              </span>
            </button>
            <div class="acc-panel">
              <div class="acc-panel__body">
                <a href={`/blog/category/${cat.slug}`} class="sm-cat-link">See all {cat.posts.length} in {cat.name} →</a>
                <ul class="sm-post-list">
                  {cat.posts.map((p) => (
                    <li>
                      <a href={`/blog/${p.data.slug}`}>{p.data.title}</a>
                      <span class="sm-post-date">{dateFmt(p.data.date)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</div>

<style>
  .sm { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--pad) clamp(3rem, 6vw, 5rem); }
  .sm-head { padding-top: calc(var(--header-h, 92px) + clamp(2rem, 5vw, 3.5rem)); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .sm-head__lede { margin-top: 1rem; font-size: 1.05rem; color: var(--gray); }

  .sm-section { padding-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--line); }
  .sm-section__title {
    font-family: var(--display); font-weight: 800; font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    color: var(--navy); margin-bottom: 1.4rem;
    display: flex; align-items: baseline; justify-content: space-between; gap: .6rem 1rem; flex-wrap: wrap;
  }
  .sm-section__all { font-family: var(--body); font-size: .88rem; font-weight: 700; color: var(--blue-600); }
  .sm-section__all:hover { color: var(--blue-700); }

  .sm-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .3rem 1.5rem; }
  .sm-row { border-bottom: 1px solid var(--line); }
  .sm-row__link {
    display: inline-flex; align-items: center; gap: .45em;
    font-weight: 700; color: var(--navy); font-size: .96rem;
    padding: .55rem 0; transition: color .2s;
  }
  .sm-row__link svg { flex-shrink: 0; transition: transform .25s var(--ease); color: var(--blue-600); }
  .sm-row__link:hover { color: var(--blue-600); }
  .sm-row__link:hover svg { transform: translateX(3px); }

  .sm-cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem clamp(1.5rem, 3vw, 3rem); }
  .sm-cat__name { font-family: var(--display); font-weight: 700; font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; color: var(--blue-600); margin-bottom: .8rem; }
  .sm-cat .sm-list { grid-template-columns: 1fr; }

  .sm-blog-accordion { max-width: none; }
  .sm-cat-count { color: var(--gray-500); font-weight: 500; }
  .sm-cat-link { display: inline-block; font-size: .86rem; font-weight: 700; color: var(--blue-600); margin-bottom: .9rem; }
  .sm-cat-link:hover { color: var(--blue-700); }
  .sm-post-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .6rem 1.5rem; }
  .sm-post-list a { display: block; color: var(--navy); font-weight: 600; font-size: .92rem; line-height: 1.3; transition: color .2s; }
  .sm-post-list a:hover { color: var(--blue-600); }
  .sm-post-date { display: block; color: var(--gray-500); font-size: .76rem; margin-top: .1rem; }
</style>
